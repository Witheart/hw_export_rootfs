#!/bin/bash
# 本脚本由 Witheart 修改，原脚本来源于 Firefly
# 更新日期：2026-05-22（针对 overlayroot 环境进行了适配优化）
# 用途：导出根文件系统到镜像文件
# 适用于 Ubuntu 系统

function showhelp()
{
    echo -e "
    hw_export_rootfs </path/to/store> [-s <source_path>] [-t <ext4|btrfs>] [-h]

    参数说明：
      </path/to/store>    指定镜像文件的存储路径
      -s <source_path>    指定要打包的源目录（在 overlayroot 系统下，默认自动识别 /media/root-ro）
      -t <ext4|btrfs>     指定镜像文件的文件系统类型（默认使用源文件系统类型）
      -h                  显示脚本的使用说明

    注意：第一个参数必须是存储路径，后面的参数可以不按顺序输入。

    功能：
      1. 将指定目录下的文件系统导出为镜像文件（兼容 overlayroot）
      2. 支持 ext4 和 btrfs 文件系统类型
      3. 自动清理 APT 和 Snap 缓存
      4. 创建版本信息文件，包含构建时间、提交信息和内核版本等
      5. [核心优化] 废弃原厂 1.5 倍冗余容量计算，统一预分配逻辑
      6. [核心优化] 修复 ext4 镜像缩容 (resize2fs) 失效的底层 Bug
    "
    exit -1
}

function prepare_rootfs()
{
    # 系统准备和基础清理
    echo -e "[1/4] 系统准备中..."
    
    # 如果源目录是可写的（或者是当前根目录），尝试提前清理
    if [ "$ROOTFS_MOUNTPOINT" = "/" ] || [ -w "$ROOTFS_MOUNTPOINT" ]; then
        systemctl enable resize-helper.service > /dev/null 2>&1
        echo -e "\n[2/4] 正在清理源目录的 APT 缓存..."
        apt-get clean -y
    else
        echo -e "\n[2/4] 源目录为只读或外部挂载，跳过前期 APT 清理（将在同步到临时目录后清理）"
    fi

    echo -e "\n[3/4] Snap 缓存清理确认"
    echo -e "\033[33m⚠️  警告：即将清理的是本机系统（本脚本运行系统）的 Snap 缓存和旧版本包！\033[0m"
    
    # 交互式确认逻辑
    local choice
    while :; do
        read -p "是否继续清理 Snap 缓存？(y/n) " choice
        case "$choice" in
            y|Y )
                echo "✅ 用户确认执行 Snap 清理"
                break
                ;;
            n|N )
                echo "⏭️  跳过 Snap 缓存清理"
                return 0
                ;;
            * )
                echo -e "\033[31m❌ 无效输入，请输入 y 或 n\033[0m"
                ;;
        esac
    done

    # 清理Snap缓存
    echo -e "\n[3.1/4] 正在清理 Snap 缓存..."
    if [[ -d "/var/lib/snapd/cache" ]]; then
        rm -rf /var/lib/snapd/cache/*
        echo "✅ Snap缓存清理完成"
    else
        echo "⚠️  Snap缓存目录不存在，跳过此步骤" >&2
    fi

    # 清理旧版本Snap包
    echo -e "\n[3.2/4] 正在检查旧版本 Snap 包..."
    OLD_VERSIONS=$(snap list --all | awk '/disabled/{print $1, $3}')
    if [[ -z "$OLD_VERSIONS" ]]; then
        echo "未找到可清理的旧版本"
    else
        echo "$OLD_VERSIONS" | while read -r snapname revision; do
            echo "正在删除: $snapname (版本 $revision)"
            if snap remove "$snapname" --revision="$revision"; then
                echo "✅ 已删除: $snapname"
            else
                echo "❌ 删除失败: $snapname (检查权限或依赖)" >&2
            fi
        done
    fi

    # ======== 添加远程软件检测 ========
    echo -e "\n[4/4] 正在检查系统环境..."
    if ! check_remote_software_locks; then
        exit 1
    fi
}

function clead_target_rootfs()
{
    ROOT_DIR=$1
    # 检测并删除 /etc/firstboot_done 文件
    if [[ -f "${ROOT_DIR}/etc/firstboot_done" ]]; then
        echo "⚠️  检测到首次启动标记文件，执行删除操作"
        rm -f "${ROOT_DIR}/etc/firstboot_done"
    else
        echo "ℹ️  未找到/etc/firstboot_done文件，跳过删除"
    fi

    # 检测并删除 ToDesk 注册文件
    if [[ -f "${ROOT_DIR}/etc/todesk/reg.conf" ]]; then
        echo "⚠️  检测到预装 todesk 注册文件，执行删除操作（重置识别码）"
        rm -f "${ROOT_DIR}/etc/todesk/reg.conf"
    else
        echo "ℹ️  未找到/etc/todesk/reg.conf文件，跳过删除"
    fi
    
    # 在临时可写目录中追加补救式的底层清理
    rm -rf ${ROOT_DIR}/var/cache/apt/archives/*
    rm -rf ${ROOT_DIR}/usr/share/doc/*
    rm -rf ${ROOT_DIR}/var/lib/apt/lists/*
    rm -rf ${ROOT_DIR}/tmp/*
    find ${ROOT_DIR}/usr/share/man/ -name "*.gz" -exec rm {} \;
    find ${ROOT_DIR}/var/log/ -type f -name "*.gz" -exec rm {} \;
    find ${ROOT_DIR}/var/log/ -type f -exec truncate -s 0 {} \;

    # 清理 systemd journal 日志
    echo "清理 systemd journal 日志..."
    if [[ -d "${ROOT_DIR}/var/log/journal" ]]; then
        rm -rf ${ROOT_DIR}/var/log/journal/*
        echo "✅ 已清理 systemd journal 日志"
    else
        echo "ℹ️  未找到 /var/log/journal 目录，跳过清理"
    fi

    for item in $(ls ${ROOT_DIR}/media/ 2>/dev/null); do
        if id ${item} > /dev/null 2>&1
        then
            chown -R ${item}:${item} ${ROOT_DIR}/media/${item}
        fi
    done

    if [[ -L "${ROOT_DIR}/var/lib/docker" ]]
    then
        orig_dir=$(readlink "${ROOT_DIR}/var/lib/docker")
        if [[ ! -d ${ROOT_DIR}/${orig_dir} ]]
        then
            rm -rf "${ROOT_DIR}/var/lib/docker"
            rsync -aqx "${orig_dir}/" "${ROOT_DIR}/var/lib/docker"
        fi
    fi
    
    # 核心安全操作：确保导出的根镜像中，media下的只读和读写挂载点是空的目录
    echo "🧹 正在清理镜像内部的外部挂载残留..."
    rm -rf ${ROOT_DIR}/media/root-ro/* ${ROOT_DIR}/media/root-rw/*
}

# 检测远程软件创建的特殊文件
function check_remote_software_locks()
{
    local fuse_path="/tmp/fuse"
    if ls -ld "$fuse_path" &> /dev/null; then
        : 
    else
        err_msg=$(ls -ld "$fuse_path" 2>&1)
        if [[ "$err_msg" =~ "权限不够" || "$err_msg" =~ "Permission denied" ]]; then
            echo -e "\033[31m错误：检测到无法访问的文件 ${fuse_path}\033[0m"
            echo -e "\033[33m⚠️  该文件通常由远程控制软件（如todesk、向日葵）创建且在运行时无法操作\033[0m"
            echo -e "请执行以下操作："
            echo -e "  1. 退出所有远程控制软件"
            echo -e "  2. 手动删除该文件：sudo rm -rf ${fuse_path}"
            echo -e "处理完成后请重新运行打包脚本！"
            exit 1
        fi
    fi
    return 0
}

function umount_img() {
    if mountpoint -q $TEMP_MOUNT_POINT; then
        umount $TEMP_MOUNT_POINT
    fi
    rm -rf $TEMP_MOUNT_POINT
}

function finish() {
    umount_img
    exit -1
}

[[ $UID -ne 0 ]] && echo -e "\033[31m should run as root \033[0m" && showhelp
[[ -n "$(which rsync)" ]] || { echo -e " rsync not found\n\033[31m apt install rsync \033[0m"; exit -1; }
[[ $# -lt 1 ]] && showhelp;

# 智能重置默认源路径：检测到 overlayroot 时自动切到只读底层分区挂载点
if [ -d "/media/root-ro" ] && mountpoint -q /media/root-ro; then
    SOURCE_PATH="/media/root-ro"
    echo -e "\033[32mℹ️  检测到当前系统运行于 overlayroot 环境。\033[0m"
    echo -e "\033[32m自动选择底层的只读根分区进行打包: ${SOURCE_PATH}\033[0m"
else
    SOURCE_PATH="/"
fi

DEST_PATH=""
STORE_FS_TYPE=""

# 参数解析
while [[ $# -gt 0 ]]; do
    case $1 in
        -s)
            SOURCE_PATH=$2
            shift 2
            ;;
        -t)
            STORE_FS_TYPE=$2
            shift 2
            ;;
        -h)
            showhelp
            ;;
        *)
            DEST_PATH=$1
            shift
            ;;
    esac
done

# 支持多行输入版本信息
echo -e "\n🖊️  请输入版本说明（支持多行输入，按回车换行，输入 . 在单独一行结束）："
commit_message=""
while IFS= read -r line; do
    [[ "$line" == "." ]] && break
    [[ -n "$line" ]] && commit_message+="${line}"$'\n'
done
commit_message="${commit_message%$'\n'}"

if [[ -z "$commit_message" ]]; then
    echo "❌ 错误：版本说明不能为空！"
    exit 1
fi

[[ -d $DEST_PATH ]] || { echo -e "\033[31m store path not exist \033[0m"; exit -1; }
[[ -d $SOURCE_PATH ]] || { echo -e "\033[31m source path $SOURCE_PATH does not exist or is not a directory \033[0m"; exit -1; }

ROOTFS_MOUNTPOINT="$SOURCE_PATH"

MEDIA_FS_TYPE=`df $DEST_PATH --output=fstype | awk 'NR==2 {print $1}'`
MEDIA_FREE_SPACE=`df $DEST_PATH -m --output=avail | awk 'NR==2 {print $1}'`

prepare_rootfs

# 智能识别底层实际文件系统类型
if [[ $STORE_FS_TYPE == "" ]]; then
    if [[ $ROOTFS_MOUNTPOINT == "/" ]]; then
        ROOTFS_DEVICE=`findmnt -n -o SOURCE --target /`
        ROOTFS_TYPE=$(blkid -o value -s TYPE ${ROOTFS_DEVICE})
    else
        ROOTFS_TYPE=$(df -T $ROOTFS_MOUNTPOINT | awk 'NR==2 {print $2}')
    fi
    STORE_FS_TYPE=$ROOTFS_TYPE
    
    # 如果还是被识别成了 overlay，强制指定为 ext4
    [[ "$STORE_FS_TYPE" == "overlay" || "$STORE_FS_TYPE" == "overlayroot" ]] && STORE_FS_TYPE="ext4"
fi

if [[ $STORE_FS_TYPE == "btrfs" ]]; then
    ROOTFS_SIZE=`btrfs filesystem usage -m $ROOTFS_MOUNTPOINT | grep "Device allocated" | awk '{print $3}'`
else
    ROOTFS_SIZE=`du -s -k $ROOTFS_MOUNTPOINT | awk '{print $1}'`
fi

# 核心修正：统一容量估算公式（按实际体积放大 10% + 300MB 缓冲）
IMAGE_SIZE=$((ROOTFS_SIZE>>10))
IMAGE_SIZE=$((IMAGE_SIZE+IMAGE_SIZE/10+300))
echo -e "MEDIA FREE SPACE SIZE \t $MEDIA_FREE_SPACE \t MBytes"
echo -e "EXPORT IMAGE SIZE \t $IMAGE_SIZE \t MBytes"

if [[ $MEDIA_FREE_SPACE -lt $IMAGE_SIZE ]]; then
    echo -e "\033[31m No enough free space on $DEST_PATH \033[0m"
    exit -1
fi

CURDATE=$(date "+%Y%m%d%H%M%S")

if [[ -f "$SOURCE_PATH/etc/os-release" ]]; then
    OS_D=$(grep "^PRETTY_NAME=" "$SOURCE_PATH/etc/os-release" | cut -d= -f2 | tr -d '"')
else
    OS_D="Unknown"
fi

IMAGE_FILE=$DEST_PATH/${OS_D// /_}_HW_${STORE_FS_TYPE}_$CURDATE.img
TEMP_MOUNT_POINT=`mktemp -d -p $DEST_PATH`

set -e
trap finish ERR INT

if [[ $STORE_FS_TYPE == "btrfs" ]]; then
    truncate -s ${IMAGE_SIZE}M $IMAGE_FILE
    mkfs.btrfs -fq -L rootfs $IMAGE_FILE
    mount -t btrfs -o noatime,compress=lzo $IMAGE_FILE $TEMP_MOUNT_POINT
    btrfs subvolume create $TEMP_MOUNT_POINT/root
    umount $TEMP_MOUNT_POINT
    mount -t btrfs -o noatime,compress=lzo,subvol=root $IMAGE_FILE $TEMP_MOUNT_POINT
else
    INODE_COUNT=$(find "${ROOTFS_MOUNTPOINT}" 2>/dev/null | wc -l)
    INODE_COUNT=$((INODE_COUNT+512))
    
    # 核心修正：废弃原 1.5 倍的区块计算，直接使用统一计算的 IMAGE_SIZE 创建镜像壳
    truncate -s ${IMAGE_SIZE}M $IMAGE_FILE
    
    # 核心修正：使用标准块大小，自动适配，彻底解决 resize2fs 失败问题
    mkfs.ext4 -Fq -L rootfs -I 256 -N $INODE_COUNT $IMAGE_FILE
    
    mount $IMAGE_FILE $TEMP_MOUNT_POINT
fi

echo "sync..."
rsync -aqx --delete --exclude={"$IMAGE_FILE","$TEMP_MOUNT_POINT"} ${ROOTFS_MOUNTPOINT}/ ${TEMP_MOUNT_POINT}/
echo "sync finish"

# 创建/追加版本信息文件
BUILD_INFO="${TEMP_MOUNT_POINT}/etc/buildinfo"
echo "📦 创建/追加版本标识文件：${BUILD_INFO}"
mkdir -p "$(dirname "$BUILD_INFO")"
{
    echo "# 系统构建信息 - $(date '+%Y-%m-%d %H:%M:%S')"
    echo "BUILD_TIMESTAMP=\"$(date --iso-8601=seconds)\""
    echo "COMMIT_MESSAGE=\"${commit_message}\""
    echo "KERNEL_VERSION=\"$(uname -r)\""
    echo "BUILD_MACHINE=\"$(uname -n)\""
    echo "----------------------------------------"
} | tee -a "$BUILD_INFO" >/dev/null

set +e
trap - ERR

clead_target_rootfs ${TEMP_MOUNT_POINT}
umount_img

if [[ "${STORE_FS_TYPE}" == "ext4" ]]; then
    # 核心修正：放开静默输出，展示终极瘦身过程的打印结果
    echo -e "\n🧹 正在对镜像进行压缩 (resize2fs)..."
    e2fsck -fy ${IMAGE_FILE}
    resize2fs -M ${IMAGE_FILE}
    tune2fs -C 1 -c 0 -i 0 -e "remount-ro" ${IMAGE_FILE}
fi
echo -e "\033[32m 根文件系统已成功导出至: $IMAGE_FILE \033[0m"