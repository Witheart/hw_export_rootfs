#!/bin/bash
# 本脚本由 Witheart 修改，原脚本来源于 Firefly
# 更新日期：2025-07-10
# 用途：导出根文件系统到镜像文件
# 适用于 Ubuntu 系统

function showhelp()
{
    echo -e "
    hw_export_rootfs </path/to/store> [-s <source_path>] [-h]

    参数说明：
      </path/to/store>    指定镜像文件的存储路径
      -s <source_path>    指定要打包的源目录（默认：/）
      -h                  显示脚本的使用说明

    注意：第一个参数必须是存储路径，后面的参数可以不按顺序输入。

    功能：
      1. 将指定目录下的文件系统分别导出为三个独立的 ext4 镜像文件：
         - rootfs.img (根分区，不含 /home 和 /var)
         - home.img (/home 分区)
         - var.img (/var 分区)
      2. 自动清理 APT 和 Snap 缓存
      3. 创建版本信息文件，包含构建时间、提交信息和内核版本等

    版本说明：
      作者：Witheart
      更新日期：2026-05-06

    版本历史：
        1.1.0 - 重新设计打包逻辑，支持将根分区、home分区、var分区分别打包为独立镜像
        1.0.8 - 增加了对 systemd journal 日志的清理

        1.0.7 - 增加了对todesk注册文件的检测和删除，防止todesk识别码一致导致的顶号问题
        1.0.6 - 增加了对远程软件生成的/etc/fuse的检测，防止打包失败（只适用于本机打包）
        1.0.5 - 支持多行输入版本信息，版本信息文件改为追加形式
        1.0.4 - 增加了对 /etc/firstboot_done 的检测和删除
        1.0.3 - 增加Snap清理确认机制，避免误清理
        1.0.2 - 增加了对版本信息文件的创建，包含构建时间、提交信息和内核版本等
        1.0.1 - 增加了对 Snap 缓存的清理功能
        1.0.0 - 初始版本，基于 Firefly 的 ff_export_rootfs 脚本修改，
                可打包指定目录下的文件系统为镜像文件
    "
    exit -1
}

function prepare_rootfs()
{
    # 系统准备和基础清理
    echo -e "[1/4] 系统准备中..."
    systemctl enable resize-helper.service > /dev/null 2>&1
    
    # 清理APT缓存
    echo -e "\n[2/4] 正在清理 APT 缓存..."
    apt-get clean -y

    echo -e "\n[3/4] Snap 缓存清理确认"
    echo -e "\033[33m⚠️  警告：即将清理的是本机系统（本脚本运行系统）的 Snap 缓存和旧版本包！\033[0m"
    
    # 交互式确认逻辑
    local choice
    while :; do
        read -p "是否继续清理 Snap 缓存？(y/n) " choice
        case "$choice" in
            y|Y )
                echo "✅ 用户确认执行 Snap 清理"
                break
                ;;
            n|N )
                echo "⏭️  跳过 Snap 缓存清理"
                return 0
                ;;
            * )
                echo -e "\033[31m❌ 无效输入，请输入 y 或 n\033[0m"
                ;;
        esac
    done

    # 清理Snap缓存
    echo -e "\n[3.1/4] 正在清理 Snap 缓存..."
    if [[ -d "/var/lib/snapd/cache" ]]; then
        rm -rf /var/lib/snapd/cache/*
        echo "✅ Snap缓存清理完成"
    else
        echo "⚠️  Snap缓存目录不存在，跳过此步骤" >&2
    fi

    # 清理旧版本Snap包
    echo -e "\n[3.2/4] 正在检查旧版本 Snap 包..."
    OLD_VERSIONS=$(snap list --all | awk '/disabled/{print $1, $3}')
    if [[ -z "$OLD_VERSIONS" ]]; then
        echo "未找到可清理的旧版本"
    else
        echo "$OLD_VERSIONS" | while read -r snapname revision; do
            echo "正在删除: $snapname (版本 $revision)"
            if snap remove "$snapname" --revision="$revision"; then
                echo "✅ 已删除: $snapname"
            else
                echo "❌ 删除失败: $snapname (检查权限或依赖)" >&2
            fi
        done
    fi

    # ======== 添加远程软件检测 ========
    echo -e "\n[4/4] 正在检查系统环境..."
    if ! check_remote_software_locks; then
        exit 1
    fi
}

function clean_rootfs_img()
{
    ROOT_DIR=$1
    # 检测并删除 /etc/firstboot_done 文件
    if [[ -f "${ROOT_DIR}/etc/firstboot_done" ]]; then
        echo "⚠️  检测到首次启动标记文件，执行删除操作"
        rm -f "${ROOT_DIR}/etc/firstboot_done"
    fi

    # 检测并删除 ToDesk 注册文件
    if [[ -f "${ROOT_DIR}/etc/todesk/reg.conf" ]]; then
        echo "⚠️  检测到预装 todesk 注册文件，执行删除操作（重置识别码）"
        rm -f "${ROOT_DIR}/etc/todesk/reg.conf"
    fi
    
    rm -rf ${ROOT_DIR}/usr/share/doc/* 2>/dev/null
    rm -rf ${ROOT_DIR}/tmp/* 2>/dev/null
    find ${ROOT_DIR}/usr/share/man/ -name "*.gz" -exec rm {} \; 2>/dev/null || true

    for item in $(ls ${ROOT_DIR}/media/ 2>/dev/null); do
        if id ${item} > /dev/null 2>&1
        then
            chown -R ${item}:${item} ${ROOT_DIR}/media/${item}
        fi
    done
}

function clean_var_img()
{
    VAR_DIR=$1
    rm -rf ${VAR_DIR}/lib/apt/lists/* 2>/dev/null
    find ${VAR_DIR}/log/ -type f -name "*.gz" -exec rm {} \; 2>/dev/null || true
    find ${VAR_DIR}/log/ -type f -exec truncate -s 0 {} \; 2>/dev/null || true

    echo "清理 systemd journal 日志..."
    if [[ -d "${VAR_DIR}/log/journal" ]]; then
        rm -rf ${VAR_DIR}/log/journal/* 2>/dev/null
        echo "✅ 已清理 systemd journal 日志"
    fi
}


# 检测远程软件创建的特殊文件
function check_remote_software_locks()
{
    # 检查源目录内的 /tmp/fuse 文件
    local fuse_path="/tmp/fuse"
    
    # 直接尝试访问文件（不依赖 -e 检测）
    if ls -ld "$fuse_path" &> /dev/null; then
        : # 文件可访问，什么都不做
    else
        # 检查错误类型是否权限问题
        err_msg=$(ls -ld "$fuse_path" 2>&1)
        if [[ "$err_msg" =~ "权限不够" || "$err_msg" =~ "Permission denied" ]]; then
            echo -e "\033[31m错误：检测到无法访问的文件 ${fuse_path}\033[0m"
            echo -e "\033[33m⚠️  该文件通常由远程控制软件（如todesk、向日葵）创建且在运行时无法操作\033[0m"
            echo -e "请执行以下操作："
            echo -e "  1. 退出所有远程控制软件"
            echo -e "  2. 手动删除该文件：sudo rm -rf ${fuse_path}"
            echo -e "处理完成后请重新运行打包脚本！"
            exit 1
        fi
    fi
    return 0
}

function umount_img() {
    if [[ -n "$TEMP_MOUNT_POINT" ]] && mountpoint -q "$TEMP_MOUNT_POINT"; then
        umount "$TEMP_MOUNT_POINT"
    fi
    [[ -n "$TEMP_MOUNT_POINT" ]] && rm -rf "$TEMP_MOUNT_POINT"
}

function finish() {
    umount_img
    exit -1
}

[[ $UID -ne 0 ]] && echo -e "\033[31m should run as root \033[0m" && showhelp
[[ -n "$(which rsync)" ]] || { echo -e " rsync not found\n\033[31m apt install rsync \033[0m"; exit -1; }
[[ $# -lt 1 ]] && showhelp;

# 新增变量
SOURCE_PATH="/"
DEST_PATH=""

# 参数解析
while [[ $# -gt 0 ]]; do
    case $1 in
        -s)
            SOURCE_PATH=$2
            shift 2
            ;;
        -h)
            showhelp
            ;;
        *)
            DEST_PATH=$1
            shift
            ;;
    esac
done

# 支持多行输入版本信息
echo -e "\n🖊️  请输入版本说明（支持多行输入，按回车换行，输入 . 在单独一行结束）："
commit_message=""
while IFS= read -r line; do
    [[ "$line" == "." ]] && break
    [[ -n "$line" ]] && commit_message+="${line}"$'\n'
done
commit_message="${commit_message%$'\n'}"  # 去除末尾换行符

# 确保版本信息不为空
if [[ -z "$commit_message" ]]; then
    echo "❌ 错误：版本说明不能为空！"
    exit 1
fi

[[ -d $DEST_PATH ]] || { echo -e "\033[31m store path not exist \033[0m"; exit -1; }
[[ -d $SOURCE_PATH ]] || { echo -e "\033[31m source path $SOURCE_PATH does not exist or is not a directory \033[0m"; exit -1; }

PORT_OVERLAYROOT=false

ROOTFS_MOUNTPOINT="$SOURCE_PATH"

MEDIA_FS_TYPE=`df $DEST_PATH --output=fstype | awk 'NR==2 {print $1}'`
MEDIA_FREE_SPACE=`df $DEST_PATH -m --output=avail | awk 'NR==2 {print $1}'`

prepare_rootfs

ROOTFS_SIZE=`du -s -k $ROOTFS_MOUNTPOINT | awk '{print $1}'`
IMAGE_SIZE=$((ROOTFS_SIZE>>10))
IMAGE_SIZE=$((IMAGE_SIZE+IMAGE_SIZE/10+300))
echo -e "MEDIA FREE SPACE SIZE \t $MEDIA_FREE_SPACE \t MBytes"
echo -e "TOTAL EXPORT IMAGES SIZE \t $IMAGE_SIZE \t MBytes"

if [[ $MEDIA_FREE_SPACE -lt $IMAGE_SIZE ]]; then
    echo -e "\033[31m No enough free space on $DEST_PATH \033[0m"
    exit -1
fi

CURDATE=$(date "+%Y%m%d%H%M%S")

# 从指定目录下获取版本信息
if [[ -f "$SOURCE_PATH/etc/os-release" ]]; then
    OS_D=$(grep "^PRETTY_NAME=" "$SOURCE_PATH/etc/os-release" | cut -d= -f2 | tr -d '"')
else
    OS_D="Unknown"
    echo -e "\033[33m Warning: Unable to determine OS version from $SOURCE_PATH/etc/os-release. Using default name: Unknown \033[0m"
fi

IMAGE_FILE_ROOTFS=$DEST_PATH/${OS_D// /_}_HW_rootfs_$CURDATE.img
IMAGE_FILE_HOME=$DEST_PATH/${OS_D// /_}_HW_home_$CURDATE.img
IMAGE_FILE_VAR=$DEST_PATH/${OS_D// /_}_HW_var_$CURDATE.img

set -e
trap finish ERR INT

function make_ext4_image() {
    local src_dir=$1
    local img_file=$2
    local vol_label=$3
    local is_rootfs=$4

    echo -e "\n[+] 开始打包分区: $vol_label ..."
    if [[ ! -d "$src_dir" ]]; then
        echo "⚠️ 目录 $src_dir 不存在，将创建一个空的分区镜像"
        mkdir -p "$src_dir"
    fi

    # 计算大小
    local size_kb
    if [ "$is_rootfs" == "true" ]; then
        size_kb=$(du -s -k --exclude=home --exclude=var ${src_dir} | awk '{print $1}')
    else
        size_kb=$(du -s -k ${src_dir} | awk '{print $1}')
    fi

    local inode_count=$(find "${src_dir}" 2>/dev/null | wc -l)
    inode_count=$((inode_count+5000))
    local block_count=$(((size_kb+inode_count/4)*15/10))
    # 最小 50MB 防止过小
    if [ $block_count -lt 51200 ]; then
        block_count=51200
    fi

    mkfs.ext4 -Fq -L $vol_label -b 1024 -I 128 -N $inode_count $img_file $block_count
    local mnt_pt=$(mktemp -d -p $DEST_PATH)
    mount $img_file $mnt_pt

    echo "    正在同步文件到 $vol_label ..."
    if [ "$is_rootfs" == "true" ]; then
        rsync -aqx --delete --exclude={"$IMAGE_FILE_ROOTFS","$IMAGE_FILE_HOME","$IMAGE_FILE_VAR","$mnt_pt","/home/*","/var/*"} ${src_dir}/ ${mnt_pt}/
    else
        rsync -aqx --delete --exclude={"$IMAGE_FILE_ROOTFS","$IMAGE_FILE_HOME","$IMAGE_FILE_VAR","$mnt_pt"} ${src_dir}/ ${mnt_pt}/
    fi

    if [ "$is_rootfs" == "true" ]; then
        # 创建/追加版本信息文件
        BUILD_INFO="${mnt_pt}/etc/buildinfo"
        echo "📦 创建版本标识文件：${BUILD_INFO}"
        mkdir -p "$(dirname "$BUILD_INFO")"
        {
            echo "# 系统构建信息 - $(date '+%Y-%m-%d %H:%M:%S')"
            echo "BUILD_TIMESTAMP=\"$(date --iso-8601=seconds)\""
            echo "COMMIT_MESSAGE=\"${commit_message}\""
            echo "KERNEL_VERSION=\"$(uname -r)\""
            echo "BUILD_MACHINE=\"$(uname -n)\""
            echo "----------------------------------------"
        } | tee -a "$BUILD_INFO" >/dev/null

        clean_rootfs_img ${mnt_pt}
    elif [ "$vol_label" == "var" ]; then
        clean_var_img ${mnt_pt}
    fi

    umount $mnt_pt
    rm -rf $mnt_pt

    echo "    优化镜像大小..."
    e2fsck -fy ${img_file} 2>&1 > /dev/null
    resize2fs -M ${img_file} 2>&1 > /dev/null
    tune2fs -C 1 -c 0 -i 0 -e "remount-ro" ${img_file} 2>&1 > /dev/null
    echo "✅ $vol_label 分区导出成功: $img_file"
}

make_ext4_image "$ROOTFS_MOUNTPOINT" "$IMAGE_FILE_ROOTFS" "rootfs" "true"
make_ext4_image "$ROOTFS_MOUNTPOINT/home" "$IMAGE_FILE_HOME" "home" "false"
make_ext4_image "$ROOTFS_MOUNTPOINT/var" "$IMAGE_FILE_VAR" "var" "false"

set +e
trap - ERR

echo -e "\n\033[32m 🎉 所有分区镜像已成功导出至: $DEST_PATH \033[0m"
echo -e "\033[32m - $IMAGE_FILE_ROOTFS \033[0m"
echo -e "\033[32m - $IMAGE_FILE_HOME \033[0m"
echo -e "\033[32m - $IMAGE_FILE_VAR \033[0m"
